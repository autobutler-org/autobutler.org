{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // TEMPORARY allowlist (added 2026-10-13, autobutler.org #174).
  // Only build/dev-time advisories with no compatible patched release.
  // Keyed by GHSA ID so any NEW advisory still fails the check.
  // Remove each entry once Nuxt or the upstream package ships a fix.
  "high": true,
  "allowlist": [
    // simple-git via @nuxt/devtools, @nuxt/cli, vite-builder: remove when Nuxt moves to simple-git >=4.0.1
