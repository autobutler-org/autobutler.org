    "GHSA-x6jw-m9v5-85vh", // simple-git <4.0.1
    "GHSA-g4wm-2vf7-vfgr", // simple-git <=3.36.0
    "GHSA-858h-whjf-mvg5", // simple-git <=3.36.0
    // node-forge via listhen/nitropack: remove when node-forge >1.4.0 ships and the lock picks it up
    "GHSA-86w9-cpqp-85rv",
    // braces via micromatch (@nuxt/content, markdownlint-cli2): remove when braces >3.0.3 ships
    "GHSA-vfj7-8cjw-p6xm",
  ],
}
